-- WS Store Panel - protected loader
-- Compatible loader: decodes the original Luau source at runtime.
local B64 = ""

local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local map = {}
for i = 1, #chars do map[string.sub(chars, i, i)] = i - 1 end

local function decode64(data)
    data = string.gsub(data, "[^"..chars.."=]", "")
    local out = {}
    local buffer = 0
    local bits = 0
    for i = 1, #data do
        local c = string.sub(data, i, i)
        if c ~= "=" then
            local v = map[c]
            if v then
                buffer = buffer * 64 + v
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local byte = math.floor(buffer / (2 ^ bits)) % 256
                    out[#out + 1] = string.char(byte)
                    buffer = buffer % (2 ^ bits)
                end
            end
        end
    end
    return table.concat(out)
end

local source = decode64(B64)
local loader = loadstring or load
assert(loader, "Este ambiente nao suporta loadstring/load.")
local fn, err = loader(source)
assert(fn, err)
return fn()
